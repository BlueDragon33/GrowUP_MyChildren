{
  "schema": "application-management.contract/v1",
  "protocol": "growup-local-first-v1",
  "contractVersion": 1,
  "application": {
    "id": "growup-mychildren",
    "name": "GrowUP MyChildren",
    "shortName": "GrowUP",
    "category": "Gia đình",
    "tier": "client",
    "repository": "BlueDragon33/GrowUP_MyChildren",
    "version": "1.9.0"
  },
  "capabilities": {
    "webLaunch": true,
    "deviceRegistry": false,
    "deviceApproval": false,
    "deviceBlock": false,
    "deviceUnblock": false,
    "deviceEditPermission": false,
    "deviceIdempotentCommands": false,
    "optimisticConcurrency": false,
    "sessions": false,
    "audit": false,
    "contentReview": false,
    "payments": false,
    "reports": true
  },
  "endpoints": {},
  "boundary": {
    "independentRuntime": true,
    "pwaOffline": true,
    "embeddedInApplicationManagement": false,
    "childRecordsInControlPlane": false,
    "healthRecordsInControlPlane": false,
    "sharedDatabaseWithOtherClients": false
  },
  "readiness": {
    "runtime": "available",
    "privacyLocalFirst": "available",
    "pwa": "available",
    "localAudit": "available",
    "deviceRegistry": "missing",
    "deviceGateway": "missing",
    "adminApi": "missing",
    "remoteAuditApi": "missing",
    "configurationReviewApi": "missing"
  },
  "requiredDeviceContract": {
    "namespace": "GU-",
    "identity": "p256-public-key-fingerprint",
    "classes": ["desktop", "tablet", "phone"],
    "accessAndEditSeparated": true
  },
  "controlPlaneAllowlist": [
    "device code and class",
    "access status",
    "edit permission",
    "app version and health status",
    "privacy-safe audit metadata",
    "configuration proposals intentionally submitted for review"
  ],
  "controlPlaneDenylist": [
    "child profile data",
    "health records",
    "nutrition records",
    "free-text private notes",
    "portfolio evidence",
    "local backup contents"
  ],
  "policy": {
    "remoteAdminReady": false,
    "applicationManagementMayInventOperationsWithoutBackend": false,
    "applicationManagementMayReadChildData": false,
    "applicationManagementMayReadHealthData": false
  }
}
